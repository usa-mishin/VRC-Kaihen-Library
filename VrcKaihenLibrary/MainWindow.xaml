                <Button Grid.Row="1" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="全データ再取得"/></StackPanel></Button>
            </Grid>
            <controls:HandCursorGridView x:Name="BoothTagGrid" Grid.Row="1" Margin="-8,18,-20,0" ItemsSource="{x:Bind VisibleBoothTags}" IsItemClickEnabled="True" ItemClick="BoothTagGrid_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource CompactGridViewItemStyle}" SizeChanged="OverviewGrid_SizeChanged">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate><DataTemplate><Border Width="{Binding CardWidth}" Height="68" Margin="7" Padding="14,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE8EC;" Foreground="#FFD0575C" FontSize="16"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" Padding="9,4" CornerRadius="11" Background="#1FD0575C" VerticalAlignment="Center"><TextBlock Text="{Binding CountText}" Foreground="#FFD0575C" FontSize="11" FontWeight="SemiBold"/></Border></Grid></Border></DataTemplate></GridView.ItemTemplate>
            </controls:HandCursorGridView>
        </Grid>

        <Grid x:Name="SettingsPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
                    <TextBlock Text="表示設定" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="一覧や詳細画面の表示方法を設定します。" Opacity="0.7" TextWrapping="Wrap"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="7">
                            <ToggleSwitch x:Name="SmartTitleShorteningToggle" Header="商品名スマート短縮機能" IsOn="True" Toggled="SmartTitleShorteningToggle_Toggled"/>
                            <TextBlock Text="SALE表記、対応アバター数、商品種別などの補助情報を自動的に省き、商品名を読みやすく表示します。元の商品名は変更しません。" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <Border Height="1" Margin="0,7" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <ComboBox x:Name="DetailPanelSizeBox" Header="右詳細パネルのサイズ" Width="220" HorizontalAlignment="Left" SelectionChanged="DetailPanelSizeBox_SelectionChanged">
                                <x:String>小</x:String><x:String>中（既定）</x:String><x:String>大</x:String><x:String>手動設定</x:String>
                            </ComboBox>
                            <TextBlock Text="詳細パネルを開いたときの基本幅を選択します。パネル左端のドラッグでも自由に調整できます。" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <Border Height="1" Margin="0,7" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <ComboBox x:Name="CardSizeBox" Header="アバター・アイテムカードのサイズ" Width="220" HorizontalAlignment="Left" SelectionChanged="CardSizeBox_SelectionChanged">
                                <x:String>小</x:String><x:String>中（既定）</x:String><x:String>大</x:String>
                            </ComboBox>
                            <TextBlock Text="アバター一覧と改変アイテム一覧に表示するカードの大きさを変更します。" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ImportSettingsPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
                    <TextBlock Text="Unityインポート先" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="分類ごとのAssets配下のフォルダ名と、Assets直下へ配置するかを設定します。アバターは常にAssets直下へ配置されます。一部商品はAssets直下にインポートすることを想定されている可能性がありますので、インポートした商品が正常に動作しない場合はAssets直下にインポートするように設定してください。またUnityパッケージのファイルサイズが大きい場合はAssets直下に配置しない場合、インポート準備に時間かかる可能性があります。" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="ImportSettingsRows" Spacing="10"/>
                        <TextBlock x:Name="ImportSettingsStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                        <controls:HandCursorButton Click="SaveImportSettings_Click" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;"/><TextBlock Text="設定を保存"/></StackPanel>
                        </controls:HandCursorButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="HelpPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="22" Padding="0,0,12,28">
                    <StackPanel Spacing="5">
                        <TextBlock Text="使い方" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="BOOTH Library Managerの商品を探して整理し、Unityへ導入するまでの基本操作を説明します。" Opacity="0.72" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border CornerRadius="12" Background="#16D0575C" BorderBrush="#50D0575C" BorderThickness="1" Padding="18">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#FFD0575C" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE7C5;" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="はじめる前に" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="BOOTH Library Managerで商品をダウンロードしてから本アプリを起動します。初回読み込みが終わると、ダウンロード済みの商品が自動的に一覧へ表示されます。" TextWrapping="Wrap" Opacity="0.82"/>
                                <TextBlock Text="※ 本アプリはBOOTH Library Managerのデータを読み取り専用で参照します。" FontSize="12" Opacity="0.66" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock Text="基本の流れ" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#FF6F4EDC"><FontIcon Glyph="&#xE77B;" Foreground="White" FontSize="21"/></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="1. アバター設定を確認する" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="最初に「アバター」を開き、各アバターのメイン呼称と識別タグが正しいか確認します。識別タグは商品説明・BOOTHタグ・ダウンロードした商品名と照合され、対応アバターを判定する基準になります。" TextWrapping="Wrap" Opacity="0.75"/><Border Background="#16D0575C" BorderBrush="#50D0575C" BorderThickness="1" CornerRadius="7" Padding="10,7"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7BA;" Foreground="#FFD0575C" FontSize="15" VerticalAlignment="Top"/><TextBlock Text="アバターではない商品がアバター一覧にある場合は、そのカードの「アイテム情報編集」から衣装・髪型・テクスチャなど正しい分類へ変更してください。" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid>
                                <FontIcon Glyph="&#xE70D;" FontSize="16" Foreground="#FFD0575C" Margin="14,3,0,3" HorizontalAlignment="Left"/>
                                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#FFD0575C"><FontIcon Glyph="&#xE721;" Foreground="White" FontSize="21"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="2. 商品を探す" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="「改変アイテム」で商品名やタグを検索します。分類タブ、対応アバター、ショップ、BOOTHタグ、更新状態も組み合わせて絞り込めます。" TextWrapping="Wrap" Opacity="0.75"/></StackPanel></Grid>
                                <FontIcon Glyph="&#xE70D;" FontSize="16" Foreground="#FFD0575C" Margin="14,3,0,3" HorizontalAlignment="Left"/>
                                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#FF66717D"><FontIcon Glyph="&#xE8A7;" Foreground="White" FontSize="21"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="3. 詳細を確認する" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="カードをクリックすると右側に詳細が開きます。商品ページ、対応アバター、BOOTHタグ、ダウンロードファイル、UnityPackageを確認できます。" TextWrapping="Wrap" Opacity="0.75"/></StackPanel></Grid>
                                <FontIcon Glyph="&#xE70D;" FontSize="16" Foreground="#FFD0575C" Margin="14,3,0,3" HorizontalAlignment="Left"/>
                                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="#FF4D8C72"><FontIcon Glyph="&#xE74C;" Foreground="White" FontSize="21"/></Border><StackPanel Grid.Column="1" Spacing="9"><TextBlock Text="4. Unityへインポートする" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="先に導入先のUnityプロジェクトを開き、詳細のUnityPackageをクリックします。Unityに確認画面が出たら内容を確認して「Import」を選びます。" TextWrapping="Wrap" Opacity="0.75"/><Border CornerRadius="9" Padding="12" Background="#123B82F6" BorderBrush="#453B82F6" BorderThickness="1"><StackPanel Spacing="9"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" Foreground="#FF3979D0" FontSize="18"/><TextBlock Grid.Column="1" Text="通常は分類ごとに Assets/衣装、Assets/テクスチャなどへ配置します。配置先は「Unityインポート先」で変更できます。" TextWrapping="Wrap"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7BA;" Foreground="#FF3979D0" FontSize="18"/><TextBlock Grid.Column="1" Text="一部の商品はAssets直下を前提にしています。導入後に動作しない場合は、その分類を「Assets直下」にして再度お試しください。" TextWrapping="Wrap"/></Grid><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE823;" Foreground="#FF3979D0" FontSize="18"/><TextBlock Grid.Column="1" Text="大きなUnityPackageは準備に時間がかかります。右下の進捗表示が完了するまでお待ちください。" TextWrapping="Wrap"/></Grid></StackPanel></Border></StackPanel></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ChangelogPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="18" Padding="0,0,12,28">
                    <StackPanel Spacing="5"><TextBlock Text="変更履歴" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="主な機能追加と改善内容を簡潔に掲載しています。" Opacity="0.72" TextWrapping="Wrap"/></StackPanel>
                    <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><TextBlock Text="最新版" Foreground="#FFD0575C" FontWeight="SemiBold"/><TextBlock Text="• 人気アバターの既定識別タグを拡充&#x0a;• ダウンロードファイルの階層表示、画像プレビュー、旧バージョン判定を改善&#x0a;• 一覧検索、表示設定、詳細パネルの操作性を改善" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
                    <Border CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="8"><TextBlock Text="これまでの主な更新" FontWeight="SemiBold"/><TextBlock Text="• アバター・改変アイテム・ショップ・BOOTHタグの管理画面を追加&#x0a;• UnityPackageの安全な展開と分類別インポートに対応&#x0a;• 未購入アバター、共通素体、対応アバター手動設定に対応&#x0a;• 初回ガイド、プライバシー・権限説明、処理通知を追加" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Border>
                    <TextBlock Text="詳細な更新情報は、配布元のリリース案内をご確認ください。" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="PrivacyPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="18" Padding="0,0,12,24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="プライバシーと安全性" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock Text="このページでは、本アプリが読み取る情報、必要な権限、通信、ファイル変更を明示します。" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border CornerRadius="10" Padding="18" Background="#10209B60" BorderBrush="#55209B60" BorderThickness="1">
                        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="24" Background="#18209B60"><FontIcon Glyph="&#xE73E;" Foreground="#FF209B60" FontSize="25"/></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="ローカル処理を基本とした安全な設計です" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="広告、利用状況解析、クラッシュ自動送信、アカウント情報収集、バックグラウンド常駐、自動起動は行いません。BOOTH Library ManagerがPC内に保存した商品情報は、読み取り専用で参照します。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel></Grid>
                    </Border>
                    <StackPanel Spacing="6"><TextBlock Text="読み取る情報" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="BOOTH Library ManagerがPC内に保存した商品名、ショップ名、商品説明、タグ、購入・ダウンロード済みバリエーション、更新日時、商品保存先を読み取ります。商品フォルダーではファイル名、フォルダー名、更新日時を確認し、Unityインポートを選んだ場合だけ対象UnityPackageの内容を検査します。氏名、住所、メールアドレス、パスワード、Cookie、ブラウザ履歴、クリップボードは読み取りません。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="通信" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="独自サーバーへのデータ送信、テレメトリー、広告通信はありません。サムネイルはHTTPSのBOOTH公式ドメインからだけ自動取得し、任意の第三者ドメインへは自動接続しません。商品ページを開く操作をした場合は、既定のブラウザーでBOOTHを開きます。画像取得時には一般的なWeb通信と同様に、画像配信元へIPアドレスとアクセス日時が伝わる可能性があります。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="Unity操作に必要な権限" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="ユーザーがUnityインポートを選んだときだけ、起動中のUnity Editorを検出し、そのプロジェクト場所を確認します。UnityプロジェクトのPackagesに本アプリ専用の公開された連携スクリプトを配置し、Libraryに一時的なインポート要求を作成します。UnityPackageはリンク、絶対パス、パストラバーサル、特殊項目、過大な項目数・展開容量を拒否してから処理します。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="保存・変更・削除" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="分類やアバター設定は %LOCALAPPDATA%\VrcKaihenLibrary\library.db に保存します。再配置したUnityPackageはBLMライブラリ直下の .VrcKaihenLibraryImportCache に通常のフォルダーとして保存します。重複ダウンロード整理は対象を表示して確認を得た場合だけ実行し、古いフォルダーはごみ箱へ移します。アンインストールしても設定DB、キャッシュ、Unityプロジェクト内の連携ファイルは自動削除しません。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="非公式ツールについて" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="本アプリはBOOTHおよびBOOTH Library Managerの運営元が提供・保証する公式製品ではなく、提携関係もありません。商品ファイルとUnityプロジェクトのバックアップを推奨します。安全性の問題を見つけた場合は配布元のGitHubリポジトリへ報告してください。" TextWrapping="Wrap" Opacity="0.78"/></StackPanel>
                    <Button Click="RevokeDataAccessConsent_Click" HorizontalAlignment="Left" Foreground="#FFD0575C">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;"/><TextBlock Text="PC内の商品情報参照への同意を取り消す"/></StackPanel>
                    </Button>
                    <TextBlock Text="安全性に配慮して設計・検査していますが、すべての環境や第三者製UnityPackageの完全な安全性を保証するものではありません。" FontSize="12" Opacity="0.62" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ContentDialog x:Name="UnpurchasedAvatarDialog" Grid.RowSpan="4" Grid.ColumnSpan="3" Title="未購入アバターを追加" PrimaryButtonText="保存" CloseButtonText="キャンセル" DefaultButton="Primary" PrimaryButtonClick="UnpurchasedAvatarDialog_PrimaryButtonClick">
