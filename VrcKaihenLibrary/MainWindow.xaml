                <StackPanel Spacing="6">
                    <TextBlock Text="アバター識別タグ" FontWeight="SemiBold"/>
                    <TextBlock Text="識別タグのテキストが商品説明・タグ・ダウンロードした商品名に含まれているか調べて自動的に対応アバターの判定を行います。メイン呼称にはこのアプリ上で表示したい名称を入力してください。表記ゆれ、英語名、BOOTH商品IDなどは＋ボタンで追加できます。大文字小文字、全角半角の違いは無視します。" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UnpurchasedAvatarIdentifierBox"/><Border Grid.Column="1" Padding="10,4" CornerRadius="12" Background="#FF555B66" VerticalAlignment="Center"><TextBlock Text="メイン呼称" Foreground="White" FontSize="12"/></Border></Grid>
                    <StackPanel x:Name="UnpurchasedAvatarIdentifierRows" Spacing="6"/>
                    <controls:HandCursorButton Click="AddUnpurchasedAvatarIdentifier_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;"/><TextBlock Text="識別タグを追加"/></StackPanel></controls:HandCursorButton>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="共通素体のアバター" FontWeight="SemiBold"/>
                    <TextBlock Text="候補を開き、共通素体として扱うアバターを複数選択できます。" FontSize="12" Opacity="0.7"/>
                    <Button x:Name="UnpurchasedSharedBodySelectionButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid><TextBlock x:Name="UnpurchasedSharedBodySelectionSummary" Text="選択なし"/><FontIcon Glyph="&#xE70D;" HorizontalAlignment="Right"/></Grid>
                        <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><Grid Width="400" Height="420" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="共通素体のアバターを選択" FontWeight="SemiBold"/><TextBox x:Name="UnpurchasedSharedBodySearchBox" Grid.Row="1" PlaceholderText="アバターを検索" TextChanged="UnpurchasedSharedBodySearchBox_TextChanged"/><ListView Grid.Row="2" ItemsSource="{x:Bind VisibleSharedBodyOptions}" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="UnpurchasedSharedBodyOption_Changed" Unchecked="UnpurchasedSharedBodyOption_Changed" HorizontalAlignment="Stretch"><Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="7" Margin="6,0,0,0"><StackPanel Orientation="Horizontal" Spacing="10"><Border Width="52" Height="52" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE77B;" FontSize="23" Opacity="0.25"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding DisplayName}" Width="280" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel></Border></CheckBox></DataTemplate></ListView.ItemTemplate></ListView></Grid></Flyout></Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="UnpurchasedAvatarValidationText" Foreground="#FFD0434A" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Border x:Name="DetailPanel" Grid.Column="2" Grid.RowSpan="4" Width="0" HorizontalAlignment="Right" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Canvas.ZIndex="20">
