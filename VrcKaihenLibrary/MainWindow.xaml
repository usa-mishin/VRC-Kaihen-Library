                <TextBlock x:Name="EmptyDescription" Text="検索条件を変更してください。" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LibraryPager" Grid.Column="1" Grid.Row="3" Visibility="Collapsed" Padding="24,4,24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
