            </StackPanel>
            <TextBlock x:Name="ResultRangeText" Grid.Column="2" VerticalAlignment="Center" Opacity="0.7"/>
        </Grid>

        <Grid x:Name="AvatarPage" Grid.Column="1" Grid.RowSpan="4" Padding="24,20,24,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3" Spacing="3">
                    <TextBlock Text="アバター" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="ダウンロード済のアバターと手動登録した未購入アバターの一覧です。クリックで詳細を表示します。" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="AvatarPurchaseFilterBox" Grid.Row="1" Grid.Column="0" SelectedIndex="0" SelectionChanged="AvatarPurchaseFilterBox_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <x:String>すべてのアバター</x:String><x:String>購入済み</x:String><x:String>未購入</x:String>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="1" Click="AddUnpurchasedAvatar_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;"/><TextBlock Text="未購入アバター追加"/></StackPanel>
                </Button>
                <controls:HandCursorButton x:Name="AvatarSortButton" Grid.Row="1" Grid.Column="3" Width="230" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8CB;" FontSize="15"/><TextBlock x:Name="AvatarSortButtonText" Grid.Column="1" Text="登録日時（新しい順）" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12"/></Grid>
                    <controls:HandCursorButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight"><MenuFlyoutItem Text="商品名（昇順）" Tag="0" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="商品名（降順）" Tag="1" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="ショップ名（昇順）" Tag="2" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="ショップ名（降順）" Tag="3" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="登録日時（新しい順）" Tag="4" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="登録日時（古い順）" Tag="5" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="更新日時（新しい順）" Tag="6" Click="AvatarSortMenuItem_Click"/><MenuFlyoutItem Text="更新日時（古い順）" Tag="7" Click="AvatarSortMenuItem_Click"/></MenuFlyout></controls:HandCursorButton.Flyout>
                </controls:HandCursorButton>
                <Button Grid.Row="1" Grid.Column="4" Click="Refresh_Click" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="全データ再取得"/></StackPanel>
                </Button>
            </Grid>
            <controls:HandCursorGridView x:Name="AvatarGrid" Grid.Row="1" Margin="-8,18,-20,0" ItemsSource="{x:Bind VisibleAvatarCards}" IsItemClickEnabled="True" ItemClick="AvatarGrid_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource CompactGridViewItemStyle}" SizeChanged="OverviewGrid_SizeChanged">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate><DataTemplate><Border Width="{Binding CardWidth}" Height="{Binding CardHeight}" Margin="7" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel><Border Height="{Binding CardWidth}" CornerRadius="10,10,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE77B;" FontSize="48" Opacity="0.2"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="5"><Border HorizontalAlignment="Right" Padding="9,4" CornerRadius="11" Background="#FFD0575C" Visibility="{Binding UnpurchasedBadgeVisibility}"><TextBlock Text="未購入" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border HorizontalAlignment="Right" Padding="9,4" CornerRadius="11" Background="#FFD0575C" Visibility="{Binding FileUpdateBadgeVisibility}"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE895;" Foreground="White" FontSize="11"/><TextBlock Text="更新あり" Foreground="White" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border></StackPanel></Grid></Border><StackPanel Padding="11,8" Spacing="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ShopName}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel></Border></DataTemplate></GridView.ItemTemplate>
            </controls:HandCursorGridView>
        </Grid>

        <Grid x:Name="ShopPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="24,20,24,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.ColumnSpan="2" Spacing="3"><TextBlock Text="ショップ" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="ダウンロード済アイテムのショップ一覧です。ショップをクリックすると改変アイテムをショップで絞り込んで表示します。" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
                <AutoSuggestBox x:Name="ShopPageSearchBox" Grid.Row="1" Grid.Column="0" PlaceholderText="ショップ名を検索" QueryIcon="Find" TextChanged="ShopPageSearchBox_TextChanged" VerticalAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" Click="Refresh_Click" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="全データ再取得"/></StackPanel></Button>
            </Grid>
            <controls:HandCursorGridView x:Name="ShopGrid" Grid.Row="1" Margin="-8,18,-20,0" ItemsSource="{x:Bind VisibleShopCards}" IsItemClickEnabled="True" ItemClick="ShopGrid_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource CompactGridViewItemStyle}" SizeChanged="OverviewGrid_SizeChanged">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate><DataTemplate><Border Width="{Binding CardWidth}" Height="84" Margin="7" Padding="11" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="60" Height="60" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE719;" FontSize="24" Opacity="0.22"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Grid></Border><TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></GridView.ItemTemplate>
            </controls:HandCursorGridView>
        </Grid>

        <Grid x:Name="BoothTagsPage" Grid.Column="1" Grid.RowSpan="4" Visibility="Collapsed" Padding="24,20,24,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.ColumnSpan="2" Spacing="3"><TextBlock Text="BOOTHタグ" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="全改変アイテムに設定されているBOOTHタグと該当商品件数の一覧です。BOOTHタグをクリックすると改変アイテムをBOOTHタグで絞り込んで表示します。" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
