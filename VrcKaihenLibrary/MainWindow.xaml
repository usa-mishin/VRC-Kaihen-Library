<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VrcKaihenLibrary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VrcKaihenLibrary.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="VRC改変ライブラリ（BLM拡張）">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Loaded="RootLayout_Loaded" SizeChanged="RootLayout_SizeChanged">
        <Grid.Resources>
            <Style x:Key="CompactGridViewItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="SideMenuButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="76"/><Setter Property="Height" Value="84"/>
                <Setter Property="Padding" Value="2"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CategoryTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="6,6,0,0"/>
                <Setter Property="Padding" Value="14,8,14,7"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DetailMenuItemStyle" TargetType="controls:HandCursorButton">
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,11"/><Setter Property="CornerRadius" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="DownloadFileButtonStyle" TargetType="controls:HandCursorButton">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:HandCursorButton">
                            <Border x:Name="FileRowBackground" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="FileRowBackground" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFF1F2F4" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="FileRowBackground" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFE4E6E9" Duration="0:0:0.06"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Storyboard x:Name="OpenDetailPanelStoryboard">
                <DoubleAnimation Storyboard.TargetName="DetailPanelTransform" Storyboard.TargetProperty="TranslateX" From="760" To="0" Duration="0:0:0.24">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="CloseDetailPanelStoryboard">
                <DoubleAnimation Storyboard.TargetName="DetailPanelTransform" Storyboard.TargetProperty="TranslateX" From="0" To="760" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="0,18,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="0">
                <controls:HandCursorButton x:Name="AvatarMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="AvatarMenu_Click" Background="#FFD0575C" Foreground="White">
                    <StackPanel Spacing="5"><FontIcon Glyph="&#xE77B;" FontSize="23"/><TextBlock Text="アバター" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="LibraryMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="LibraryMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="5"><FontIcon Glyph="&#xE8A9;" FontSize="23"/><TextBlock Text="改変アイテム" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="ShopMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="ShopMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="5"><FontIcon Glyph="&#xE719;" FontSize="23"/><TextBlock Text="ショップ" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="BoothTagsMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="BoothTagsMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="5"><FontIcon Glyph="&#xE8EC;" FontSize="23"/><TextBlock Text="BOOTHタグ" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="ImportSettingsMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="ImportSettingsMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="4"><FontIcon Glyph="&#xE7B8;" FontSize="23"/><TextBlock FontSize="9" LineHeight="11" TextAlignment="Center" HorizontalAlignment="Center"><Run Text="Unity"/><LineBreak/><Run Text="インポート先"/></TextBlock></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="SettingsMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="SettingsMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="5"><FontIcon Glyph="&#xE713;" FontSize="23"/><TextBlock Text="表示設定" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </controls:HandCursorButton>
                <controls:HandCursorButton x:Name="HelpMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="HelpMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                    <StackPanel Spacing="5">
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                            <Path Width="24" Height="24" Data="M3,2 L12,7 L21,2 L21,14 L12,22 L3,14 Z M12,7 L12,22"
                                  Stroke="{Binding Foreground, ElementName=HelpMenuButton}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="使い方" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </controls:HandCursorButton>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="2" HorizontalAlignment="Center">
                    <controls:HandCursorButton x:Name="PrivacyMenuButton" Style="{StaticResource SideMenuButtonStyle}" Click="PrivacyMenu_Click" Background="Transparent" Foreground="#FFD0575C">
                        <StackPanel Spacing="5"><FontIcon Glyph="&#xE72E;" FontSize="23"/><TextBlock Text="ポリシー" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
                    </controls:HandCursorButton>
                    <Border Margin="7,2,7,0" Padding="7,3" CornerRadius="7" Background="#10D0575C" BorderBrush="#38D0575C" BorderThickness="1">
                        <TextBlock Text="非公式" Foreground="#FFD0575C" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                    <controls:HandCursorButton x:Name="AppVersionButton" Click="AppVersionButton_Click" Margin="5,5,5,12" MinWidth="64" Padding="5,5"
                            CornerRadius="10" Background="#16D0575C" BorderBrush="#45D0575C" BorderThickness="1"
                            HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="変更履歴を表示">
                        <TextBlock x:Name="AppVersionText" Text="v1.0.0.0" Foreground="#FFD0575C" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </controls:HandCursorButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="InitialLoadingOverlay" Grid.Column="1" Grid.RowSpan="4"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Canvas.ZIndex="18">
            <Border Width="430" MaxWidth="430" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing Width="48" Height="48" IsActive="True" Foreground="#FFD0575C"/>
                    <TextBlock x:Name="InitialLoadingTitle" Text="BOOTH Library Managerを読み込み中"
                               FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InitialLoadingDescription" Text="商品データを準備しています。しばらくお待ちください。"
                               Opacity="0.72" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="LibraryHeader" Grid.Column="1" Visibility="Collapsed" Padding="24,20,24,12" ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="LibraryHeading" Grid.ColumnSpan="8" Spacing="3">
                <TextBlock x:Name="LibraryTitle" Text="改変アイテム" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="改変用アイテム（衣装・髪型・テクスチャ等）の一覧です。クリックで詳細を表示します。" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
            <Button x:Name="CompactFiltersButton" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71C;"/><TextBlock Text="検索・フィルタ"/></StackPanel><Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><StackPanel Width="360" Spacing="10"><TextBlock Text="検索・フィルタ" FontWeight="SemiBold"/><AutoSuggestBox x:Name="CompactSearchBox" PlaceholderText="商品名、タグを検索" QueryIcon="Find" TextChanged="CompactSearchBox_TextChanged"/><ComboBox x:Name="CompactAvatarFilterBox" Header="対応アバター" ItemsSource="{x:Bind AvatarFilterOptions}" DisplayMemberPath="DisplayName" SelectionChanged="CompactAvatarFilterBox_SelectionChanged" HorizontalAlignment="Stretch"/><ComboBox x:Name="CompactShopFilterBox" Header="ショップ" ItemsSource="{x:Bind ShopFilterOptions}" DisplayMemberPath="DisplayName" SelectionChanged="CompactShopFilterBox_SelectionChanged" HorizontalAlignment="Stretch"/><ComboBox x:Name="CompactBoothTagFilterBox" Header="BOOTHタグ" ItemsSource="{x:Bind BoothTagFilterOptions}" DisplayMemberPath="Name" SelectionChanged="CompactBoothTagFilterBox_SelectionChanged" HorizontalAlignment="Stretch"/><ToggleSwitch x:Name="CompactFreeDownloadOnlySwitch" Toggled="CompactFreeDownloadOnlySwitch_Toggled" OffContent="無料/ギフト" OnContent="無料/ギフト"/><ToggleSwitch x:Name="CompactFileUpdateOnlySwitch" Toggled="CompactFileUpdateOnlySwitch_Toggled" OffContent="更新あり" OnContent="更新あり"/><ToggleSwitch x:Name="CompactExcludeSharedBodySwitch" Toggled="CompactExcludeSharedBodySwitch_Toggled" OffContent="共通素体を除外" OnContent="共通素体を除外" IsEnabled="False"/><Button Click="ResetFilters_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;"/><TextBlock Text="フィルタをクリア"/></StackPanel></Button></StackPanel></Flyout></Button.Flyout></Button>
            <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Grid.Column="0" PlaceholderText="商品名、タグを検索" TextChanged="SearchBox_TextChanged" QueryIcon="Find" VerticalAlignment="Center"/>
            <Button x:Name="AvatarFilterButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                <Grid><TextBlock x:Name="AvatarFilterButtonText" Text="すべての対応アバター" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE70D;" HorizontalAlignment="Right"/></Grid>
                <Button.Flyout>
                    <Flyout x:Name="AvatarFilterFlyout" Placement="BottomEdgeAlignedRight">
                        <Grid Width="400" Height="430" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="対応アバターを選択" FontWeight="SemiBold"/>
                            <TextBox x:Name="AvatarFilterSearchBox" Grid.Row="1" PlaceholderText="アバターを検索" TextChanged="AvatarFilterSearchBox_TextChanged"/>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind VisibleAvatarFilterOptions}" IsItemClickEnabled="True" ItemClick="AvatarFilterGrid_ItemClick" SelectionMode="None" HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate><Border CornerRadius="9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8"><StackPanel Orientation="Horizontal" Spacing="12"><Border Width="52" Height="52" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE77B;" FontSize="23" Opacity="0.25"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding DisplayName}" Width="300" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ShopFilterButton" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                <Grid><TextBlock x:Name="ShopFilterButtonText" Text="すべてのショップ" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE70D;" HorizontalAlignment="Right"/></Grid>
                <Button.Flyout>
                    <Flyout x:Name="ShopFilterFlyout" Placement="BottomEdgeAlignedRight">
                        <Grid Width="360" Height="430" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="ショップを選択" FontWeight="SemiBold"/>
                            <TextBox x:Name="ShopFilterSearchBox" Grid.Row="1" PlaceholderText="ショップを検索" TextChanged="ShopFilterSearchBox_TextChanged"/>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind VisibleShopFilterOptions}" IsItemClickEnabled="True" ItemClick="ShopFilterList_ItemClick" SelectionMode="None" HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate><Border CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8"><StackPanel Orientation="Horizontal" Spacing="10"><Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE77B;" Opacity="0.25"/><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding DisplayName}" Width="280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="BoothTagFilterButton" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                <Grid><TextBlock x:Name="BoothTagFilterButtonText" Text="タグ指定なし" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE70D;" HorizontalAlignment="Right"/></Grid>
                <Button.Flyout><Flyout x:Name="BoothTagFilterFlyout" Placement="BottomEdgeAlignedRight"><Grid Width="360" Height="430" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="BOOTHタグを選択" FontWeight="SemiBold"/><TextBox x:Name="BoothTagFilterSearchBox" Grid.Row="1" PlaceholderText="タグを検索" TextChanged="BoothTagFilterSearchBox_TextChanged"/><ListView Grid.Row="2" ItemsSource="{x:Bind VisibleBoothTagFilterOptions}" IsItemClickEnabled="True" ItemClick="BoothTagFilterList_ItemClick" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.65"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Flyout></Button.Flyout>
            </Button>
            <StackPanel x:Name="QuickFilterSwitches" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ToggleSwitch x:Name="FreeDownloadOnlySwitch" Toggled="FreeDownloadOnlySwitch_Toggled" OffContent="無料/ギフト" OnContent="無料/ギフト" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="FileUpdateOnlySwitch" Toggled="FileUpdateOnlySwitch_Toggled" OffContent="更新あり" OnContent="更新あり" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="ExcludeSharedBodySwitch" Toggled="ExcludeSharedBodySwitch_Toggled" OffContent="共通素体を除外" OnContent="共通素体を除外" IsEnabled="False" VerticalAlignment="Center"/>
                <Button x:Name="ResetFiltersButton" Click="ResetFilters_Click" MinWidth="0" Padding="4,6" VerticalAlignment="Center" ToolTipService.ToolTip="フィルタをクリア" Background="Transparent" BorderThickness="0" Opacity="0.68">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;"/><TextBlock Text="フィルタをクリア"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="LibraryToolbar" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Padding="24,0,24,10" ColumnSpacing="12" RowSpacing="0" SizeChanged="LibraryToolbar_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="CategoryTabsScroller" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CategoryTabs" Orientation="Horizontal" Spacing="4" SizeChanged="CategoryTabs_SizeChanged"/>
            </ScrollViewer>
            <controls:HandCursorButton x:Name="CategorySelectorButton" Visibility="Collapsed" MinWidth="150" MaxWidth="230" Style="{StaticResource CategoryTabButtonStyle}" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CategorySelectorText" Text="すべて" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/></Grid>
                <controls:HandCursorButton.Flyout>
                    <Flyout x:Name="CategorySelectorFlyout" Placement="BottomEdgeAlignedLeft">
                        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="8"/></Style></Flyout.FlyoutPresenterStyle>
                        <ScrollViewer Width="260" MaxHeight="430" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CategorySelectorOptions" Spacing="2"/></ScrollViewer>
                    </Flyout>
                </controls:HandCursorButton.Flyout>
            </controls:HandCursorButton>
            <controls:HandCursorButton x:Name="SortButton" Grid.Column="1" Width="230" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8CB;" FontSize="15"/>
                    <TextBlock x:Name="SortButtonText" Grid.Column="1" Text="登録日時 (新しい順)" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12"/>
                </Grid>
                <controls:HandCursorButton.Flyout>
                    <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="8"/></Style></Flyout.FlyoutPresenterStyle>
                        <Grid x:Name="SortOptionsGrid" ColumnSpacing="2" RowSpacing="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        </Grid>
                    </Flyout>
                </controls:HandCursorButton.Flyout>
            </controls:HandCursorButton>
            <Button x:Name="RefreshLibraryButton" Grid.Column="2" Click="Refresh_Click" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="全データ再取得"/></StackPanel>
            </Button>
            <Border x:Name="CategorySelectionLine" Grid.Row="1" Grid.ColumnSpan="3" Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch"/>
        </Grid>

        <Grid x:Name="LibraryContent" Grid.Column="1" Grid.Row="2" Visibility="Collapsed">
            <controls:HandCursorGridView x:Name="ItemsGrid" Margin="16,0,4,16" Padding="0" ItemsSource="{x:Bind VisibleItems}" ItemContainerStyle="{StaticResource CompactGridViewItemStyle}" IsItemClickEnabled="True" ItemClick="ItemsGrid_ItemClick" SelectionMode="None" SizeChanged="ItemsGrid_SizeChanged">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}" Margin="4" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border Height="{Binding CardWidth}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                                    <Grid>
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Opacity="0.25"/>
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Spacing="4">
                                            <Border HorizontalAlignment="Left" Padding="8,3" CornerRadius="10" Background="{Binding CategoryBadgeBrush}"><TextBlock Text="{Binding Category}" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="4">
                                            <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="10" Background="{Binding PurchasedPackBadgeBrush}" BorderBrush="{Binding PurchasedPackBadgeBorderBrush}" BorderThickness="1" Visibility="{Binding PurchasedPackBadgeVisibility}">
                                                <TextBlock Text="{Binding PurchasedPackType}" Foreground="{Binding PurchasedPackBadgeForegroundBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="10" Background="#CC555B66" Visibility="{Binding CompatibilityCountBadgeVisibility}"><TextBlock Text="{Binding CompatibleAvatarCountText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border>
                                            <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="10" Background="#FFD0575C" Visibility="{Binding FileUpdateBadgeVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE895;" Foreground="White" FontSize="11"/><TextBlock Text="更新あり" Foreground="White" FontSize="11" FontWeight="SemiBold"/></StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Height="72" Padding="10,7,10,5" Spacing="3">
